    <path
        android:pathData="M35.1,37.2 H45.18 V47.28 H35.1 M45.18,42.24 H55.26 M35.1,60.72 H45.18 V70.8 H35.1 M45.18,65.76 H55.26 M55.26,42.24 V65.76 M55.26,54 H64.5"
