<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer the login token (stored with DataStore under files/datastore). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
